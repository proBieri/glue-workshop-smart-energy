# .env.example — nach .env kopieren und ausfüllen (.env ist in .gitignore)
#
#   cp .env.example .env

# --- opencode mit Infomaniak AI Tools (Qwen) --------------------------------
# Token: Infomaniak Manager → AI Tools → API-Token erzeugen
INFOMANIAK_API_KEY=
# Produkt-ID der AI Tools (Zahl in der Manager-URL des AI-Tools-Produkts)
INFOMANIAK_PRODUCT_ID=
# Modell-ID; verfügbare Modelle anzeigen mit:
#   docker compose run --rm opencode modelle
# Standard (09.11.2026): Qwen/Qwen3.5-397B-A17B-FP8 — 200k Kontext. Qwen3.5-122B (wie gplug-ch/ki-workshop)
# bietet unser Infomaniak-Produkt nicht an. Alternative: moonshotai/Kimi-K2.6
INFOMANIAK_MODEL=Qwen/Qwen3.5-397B-A17B-FP8
# Optional: Kontextfenster / max. Ausgabe für opencode. Kleiner = opencode fasst den
# Verlauf früher zusammen = weniger Kosten (jeder Schritt schickt den ganzen Verlauf mit).
# Qwen3.5-397B kann bis 200000 (Kimi-K2.6: 249984); Standard hier 80000 / 16384.
#INFOMANIAK_CONTEXT=80000
#INFOMANIAK_OUTPUT=16384
# Kostenbremse: höchstens so viele Schritte pro Auftrag, dann hält der Agent an
# und berichtet (gemessen ohne Bremse: bis 218 Schritte, ~17 CHF für UC1)
# (UC2 brauchte am 05.11.2026 mit 80 Schritten zu wenig — Standard jetzt 120)
#OPENCODE_STEPS=120
# Optional: Modell vor jeder Antwort "denken" lassen (deutlich langsamer, ~2–3 min statt ~20 s)
#INFOMANIAK_THINKING=on
# Optional: anderer Endpunkt (Standard: https://api.infomaniak.com/2/ai/<ID>/openai/v1)
#INFOMANIAK_BASE_URL=

# --- Claude Code im Container (optional) -------------------------------------
# Ohne Schlüssel: beim ersten Start Link im Browser öffnen und Code einfügen
#ANTHROPIC_API_KEY=

# Optional: bestimmte opencode-Version im Container (leer = neueste v2)
#OPENCODE_VERSION=

# --- Emulator -----------------------------------------------------------------
# auto = BKW-API live, solange die Emulator-Uhr der echten Zeit entspricht
# live | fixture | error (Netzwerkfehler simulieren)
#BKW_MODE=auto
# Port des Emulators auf dem Notebook (falls 8080 belegt ist)
#EMU_PORT=8080
# Port der opencode-Weboberfläche (docker compose up opencode-web)
#OPENCODE_WEB_PORT=4096
# Port der Referenzlösung (docker compose up -d referenz)
#REFERENZ_PORT=8090
